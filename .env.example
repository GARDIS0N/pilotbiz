# ==============================================================================
# BizPilot KE — AI-Powered Business Management Platform for Kenyan SMEs
# "Run your business. Know your numbers. Grow with confidence."
# ==============================================================================
# Copy this file to `.env.local` and configure optional integrations as needed.
# NEVER commit `.env.local`, API keys, service-role keys, or passwords to git.
# ==============================================================================

# 1. Server & Environment Configuration
PORT=5173
NODE_ENV=development
HOST=0.0.0.0

# 2. Supabase PostgreSQL & Auth (Optional — falls back to Local Persistent Mode)
# Create a free project at https://supabase.com and run:
# supabase/migrations/20261020000000_bizpilot_ke_schema.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 3. Server-Side AI Provider for BizPilot Copilot (Optional)
# Read exclusively on the backend in `server/bizpilotRouter.ts`.
# Never exposed to frontend browser code.
# If omitted, BizPilot Copilot automatically uses the verified Deterministic
# Kenyan SME Business Analyst Engine so all features work 100% free without AI keys.
GEMINI_API_KEY=
OPENAI_API_KEY=
