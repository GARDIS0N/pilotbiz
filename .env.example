# ==============================================================================
# Jifuno Environment Variables Configuration
# ==============================================================================
# All variables should be configured in Vercel:
# Project Dashboard > Settings > Environment Variables (for Production AND Preview)
# For local development, copy this file to .env or .env.local
# ==============================================================================

# [BROWSER-EXPOSED] (VITE_ prefix): Supabase project HTTPS URL for learner auth and data
# Where to set: Vercel Project > Settings > Environment Variables (Production & Preview)
VITE_SUPABASE_URL=https://your-project.supabase.co

# [BROWSER-EXPOSED] (VITE_ prefix): Supabase public anonymous API key for browser client
# Where to set: Vercel Project > Settings > Environment Variables (Production & Preview)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# [SERVER-ONLY]: Supabase project URL for serverless backend API functions (/api/*)
# Where to set: Vercel Project > Settings > Environment Variables (Production & Preview)
SUPABASE_URL=https://your-project.supabase.co

# [SERVER-ONLY]: Supabase anonymous key for serverless backend API functions (/api/*)
# Where to set: Vercel Project > Settings > Environment Variables (Production & Preview)
SUPABASE_ANON_KEY=your-supabase-anon-key

# [SERVER-ONLY]: Google Gemini API Key for Socratic AI Tutor & Multimodal Vision/Voice
# Where to set: Vercel Project > Settings > Environment Variables (Production & Preview)
GEMINI_API_KEY=your-gemini-api-key

# [SERVER & BROWSER]: Canonical base URL of the deployed application (used for redirects and links)
# Where to set: Vercel Project > Settings > Environment Variables (Production & Preview)
APP_URL=https://jifuno.vercel.app

# [SERVER-ONLY]: Comma-separated list of allowed CORS origins for Express API endpoints
# Where to set: Vercel Project > Settings > Environment Variables (Production & Preview)
ALLOWED_ORIGINS=https://jifuno.vercel.app,http://localhost:5173,http://localhost:3000

# [SERVER & BUILD]: Runtime environment mode ('production' | 'development'). Set automatically by Vercel.
# Where to set: Vercel automatically sets this to 'production' on deployed builds
NODE_ENV=production

# [SERVER-ONLY]: Alert Webhook URL (WhatsApp Gateway / Slack / Discord / Generic webhook)
# Triggers on 5xx error spikes (>5 in 5m), database downtime, or failed scheduled jobs
# Where to set: Vercel Project > Settings > Environment Variables (Production & Preview)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# [SERVER-ONLY]: Shared secret header for securing scheduled cron endpoints (/api/cron/*)
# Where to set: Vercel Project > Settings > Environment Variables (Production)
CRON_SECRET=your-random-cron-secret-32-chars

# [SERVER-ONLY, LOCAL DEV ONLY]: Port for local Express standalone server (default: 3000). Ignored on Vercel.
# Where to set: Local .env only
PORT=3000
